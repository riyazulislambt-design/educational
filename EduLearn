        // QUIZ
        // ===================================================
        function initQuiz() {
            const selector = document.getElementById('topicSelector');
            selector.innerHTML = Object.entries(QUIZ_DATA).map(([key, val]) => `
        <div class="topic-card ${key === state.quizTopic ? 'selected' : ''}" onclick="selectTopic('${key}')">
            <div class="topic-emoji">${val.emoji}</div>
            <div class="topic-name">${val.name}</div>
