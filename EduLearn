            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .toast-success {
            border-color: var(--success);
        }

        .toast-error {
            border-color: var(--danger);
        }

        .toast-info {
            border-color: var(--primary);
        }

        .toast-warning {
            border-color: var(--warning);
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes slideOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }

            to {
                transform: translateX(100%);
                opacity: 0;
            }
        }

        /* ===== MODAL ===== */
        .modal-overlay {
