        function selectTopic(topic) {
            state.quizTopic = topic;
            document.querySelectorAll('.topic-card').forEach(c => c.classList.remove('selected'));
            event.currentTarget.classList.add('selected');
        }

        function startQuiz() {
            state.currentQuestion = 0;
            state.quizScore = 0;
            state.correctAnswers = 0;
            state.wrongAnswers = 0;

            document.getElementById('quizSelector').classList.add('hidden');
            document.getElementById('quizGame').classList.remove('hidden');
            document.getElementById('quizResults').classList.add('hidden');

            loadQuestion();
        }

        function loadQuestion() {
            const questions = QUIZ_DATA[state.quizTopic].questions;
            const q = questions[state.currentQuestion];
            const total = questions.length;

            document.getElementById('questionCounter').textContent = `Question ${state.currentQuestion + 1} of ${total}`;
            document.getElementById('quizScore').textContent = state.quizScore;
            document.getElementById('quizProgressBar').style.width = `${(state.currentQuestion / total) * 100}%`;
            document.getElementById('questionText').textContent = q.q;
            document.getElementById('quizFeedback').className = 'quiz-feedback';
            document.getElementById('quizFeedback').textContent = '';
            document.getElementById('nextBtn').classList.add('hidden');

            const letters = ['A', 'B', 'C', 'D'];
            document.getElementById('optionsGrid').innerHTML = q.options.map((opt, i) => `
        <button class="option-btn" onclick="selectAnswer(${i})" id="opt-${i}">
            <span class="option-letter">${letters[i]}</span>
            <span>${opt}</span>
        </button>
    `).join('');

            state.quizAnswered = false;
        }

        function selectAnswer(index) {
            if (state.quizAnswered) return;
            state.quizAnswered = true;

            const q = QUIZ_DATA[state.quizTopic].questions[state.currentQuestion];
            const isCorrect = index === q.correct;
            const feedback = document.getElementById('quizFeedback');
            const nextBtn = document.getElementById('nextBtn');

            // Disable all options
            document.querySelectorAll('.option-btn').forEach(btn => btn.disabled = true);

            // Mark correct/wrong
            document.getElementById(`opt-${q.correct}`).classList.add('correct');
            if (!isCorrect) {
                document.getElementById(`opt-${index}`).classList.add('wrong');
                state.wrongAnswers++;
            } else {
                state.correctAnswers++;
                state.quizScore += 100;
                document.getElementById('quizScore').textContent = state.quizScore;
            }

            // Feedback
            feedback.textContent = isCorrect
                ? `✅ Correct! ${q.explanation}`
                : `❌ Wrong. ${q.explanation}`;
            feedback.className = `quiz-feedback show ${isCorrect ? 'correct' : 'wrong'}`;

            nextBtn.classList.remove('hidden');

            const total = QUIZ_DATA[state.quizTopic].questions.length;
            if (state.currentQuestion === total - 1) {
                nextBtn.textContent = 'See Results 🏆';
            }
        }

        function nextQuestion() {
            const total = QUIZ_DATA[state.quizTopic].questions.length;
            state.currentQuestion++;
            if (state.currentQuestion >= total) {
                showResults();
            } else {
                loadQuestion();
            }
        }

        function showResults() {
            document.getElementById('quizGame').classList.add('hidden');
            document.getElementById('quizResults').classList.remove('hidden');

            const total = QUIZ_DATA[state.quizTopic].questions.length;
            const percentage = Math.round((state.correctAnswers / total) * 100);
            const xp = state.quizScore + (percentage === 100 ? 50 : 0);

            document.getElementById('finalScore').textContent = percentage + '%';
            document.getElementById('correctCount').textContent = state.correctAnswers;
            document.getElementById('wrongCount').textContent = state.wrongAnswers;
            document.getElementById('xpEarned').textContent = xp;

            // Animate score circle
            const deg = (percentage / 100) * 360;
            const circle = document.getElementById('scoreCircle');
            circle.style.setProperty('--score-deg', deg + 'deg');
            circle.style.background = `conic-gradient(var(--primary) ${deg}deg, rgba(255,255,255,0.1) 0deg)`;

            // Set result message
            let title, msg;
            if (percentage === 100) { title = '🏆 Perfect Score!'; msg = 'Outstanding! You answered everything correctly!'; }
            else if (percentage >= 80) { title = '🌟 Excellent!'; msg = 'Great job! You have a strong grasp of this topic.'; }
            else if (percentage >= 60) { title = '👍 Good Work!'; msg = 'Solid performance! Keep practicing to improve.'; }
            else { title = '📚 Keep Learning!'; msg = 'Don\'t give up! Review the material and try again.'; }

            document.getElementById('resultTitle').textContent = title;
            document.getElementById('resultMsg').textContent = msg;

            // Update XP
            state.totalXP += xp;
            showToast(`+${xp} XP Earned! ${title}`, 'success');
        }

        function retryQuiz() {
            startQuiz();
        }

        function backToTopics() {
            document.getElementById('quizResults').classList.add('hidden');
            document.getElementById('quizGame').classList.add('hidden');
            document.getElementById('quizSelector').classList.remove('hidden');
            initQuiz();
        }

