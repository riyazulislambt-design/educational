<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduLearn - Interactive Learning Platform</title>
    <style>
        /* ===== RESET & ROOT VARIABLES ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6C63FF;
            --secondary: #FF6584;
            --accent: #43E97B;
            --dark: #1A1A2E;
            --darker: #16213E;
            --card-bg: #0F3460;
            --text: #E0E0E0;
            --text-muted: #A0A0B0;
            --success: #43E97B;
            --warning: #FFD93D;
            --danger: #FF6584;
            --gradient: linear-gradient(135deg, #6C63FF, #FF6584);
            --card-shadow: 0 8px 32px rgba(108, 99, 255, 0.2);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--dark);
            color: var(--text);
            overflow-x: hidden;
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--darker);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 4px;
        }

        /* ===== NAVIGATION ===== */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(26, 26, 46, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(108, 99, 255, 0.3);
            z-index: 1000;
            padding: 0 2rem;
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-logo {
            font-size: 1.6rem;
            font-weight: 800;
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            cursor: pointer;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 0.5rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: var(--transition);
            cursor: pointer;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: white;
            background: rgba(108, 99, 255, 0.2);
        }

        .nav-btn {
            background: var(--gradient);
            color: white !important;
            border-radius: 25px !important;
            padding: 0.5rem 1.5rem !important;
        }

        .hamburger {
            display: none;
            flex-direction: column;
            cursor: pointer;
            gap: 5px;
        }

        .hamburger span {
            width: 25px;
            height: 3px;
            background: var(--primary);
            border-radius: 3px;
            transition: var(--transition);
        }

        /* ===== PAGES ===== */
        .page {
            display: none;
            min-height: 100vh;
            padding-top: 65px;
        }

        .page.active {
            display: block;
        }

        /* ===== HERO SECTION ===== */
        .hero {
            padding: 5rem 2rem 4rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at center, rgba(108, 99, 255, 0.1) 0%, transparent 60%);
            animation: pulse 4s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 0.5;
            }

            50% {
                transform: scale(1.1);
                opacity: 1;
            }
        }

        .hero-badge {
            display: inline-block;
            background: rgba(108, 99, 255, 0.2);
            border: 1px solid rgba(108, 99, 255, 0.5);
            color: var(--primary);
            padding: 0.4rem 1.2rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            animation: fadeInDown 0.6s ease;
        }

        .hero h1 {
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 1.5rem;
            animation: fadeInUp 0.8s ease;
        }

        .hero h1 span {
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1.1rem;
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto 2.5rem;
            line-height: 1.7;
            animation: fadeInUp 1s ease;
        }

        .hero-btns {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            animation: fadeInUp 1.2s ease;
        }

        .btn-primary {
            background: var(--gradient);
            color: white;
            border: none;
            padding: 0.9rem 2.5rem;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 20px rgba(108, 99, 255, 0.4);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(108, 99, 255, 0.6);
        }

        .btn-outline {
            background: transparent;
            color: var(--text);
            border: 2px solid rgba(108, 99, 255, 0.5);
            padding: 0.9rem 2.5rem;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-outline:hover {
            border-color: var(--primary);
            background: rgba(108, 99, 255, 0.1);
            transform: translateY(-3px);
        }

        /* ===== STATS ===== */
        .stats-bar {
            display: flex;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
            padding: 3rem 2rem;
            background: rgba(15, 52, 96, 0.3);
            border-top: 1px solid rgba(108, 99, 255, 0.2);
            border-bottom: 1px solid rgba(108, 99, 255, 0.2);
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 2.2rem;
            font-weight: 800;
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 0.3rem;
        }

        /* ===== SECTIONS ===== */
        .section {
            padding: 4rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .section-header h2 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.8rem;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1rem;
        }

        .section-tag {
            display: inline-block;
            background: rgba(108, 99, 255, 0.15);
            color: var(--primary);
            padding: 0.3rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* ===== COURSES GRID ===== */
        .courses-filter {
            display: flex;
            gap: 0.8rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 2.5rem;
        }

        .filter-btn {
            background: rgba(108, 99, 255, 0.1);
            border: 1px solid rgba(108, 99, 255, 0.3);
            color: var(--text-muted);
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .filter-btn.active,
        .filter-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .course-card {
            background: var(--card-bg);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(108, 99, 255, 0.1);
            transition: var(--transition);
            cursor: pointer;
            animation: fadeInUp 0.5s ease;
        }

        .course-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--card-shadow);
            border-color: rgba(108, 99, 255, 0.4);
        }

        .course-image {
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            position: relative;
        }

        .course-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 0.25rem 0.8rem;
            border-radius: 15px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-beginner {
            background: rgba(67, 233, 123, 0.2);
            color: var(--success);
        }

        .badge-intermediate {
            background: rgba(255, 217, 61, 0.2);
            color: var(--warning);
        }

        .badge-advanced {
            background: rgba(255, 101, 132, 0.2);
            color: var(--danger);
        }

        .course-body {
            padding: 1.5rem;
        }

        .course-category {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .course-title {
            font-size: 1.05rem;
            font-weight: 700;
            margin-bottom: 0.7rem;
            line-height: 1.4;
        }

        .course-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 1rem;
        }

        .course-meta {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 1.2rem;
        }

        .course-rating {
            color: var(--warning);
        }

        .course-progress-bar {
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            margin-bottom: 0.5rem;
            overflow: hidden;
        }

        .course-progress-fill {
            height: 100%;
            background: var(--gradient);
            border-radius: 3px;
            transition: width 1s ease;
        }

        .progress-text {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .enroll-btn {
            width: 100%;
            background: var(--gradient);
            border: none;
            color: white;
            padding: 0.8rem;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 1rem;
            transition: var(--transition);
        }

        .enroll-btn:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }

        /* ===== QUIZ APP ===== */
        .quiz-container {
            max-width: 700px;
            margin: 0 auto;
        }

        .quiz-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .quiz-selector {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .topic-card {
            background: var(--card-bg);
            border: 2px solid rgba(108, 99, 255, 0.2);
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .topic-card:hover,
        .topic-card.selected {
            border-color: var(--primary);
            background: rgba(108, 99, 255, 0.15);
            transform: scale(1.02);
        }

        .topic-emoji {
            font-size: 2.5rem;
            margin-bottom: 0.8rem;
        }

        .topic-name {
            font-weight: 600;
            margin-bottom: 0.3rem;
        }

        .topic-count {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .quiz-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 2.5rem;
            border: 1px solid rgba(108, 99, 255, 0.2);
        }

        .quiz-progress-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .quiz-progress-bar-wrap {
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            margin-bottom: 2rem;
            overflow: hidden;
        }

        .quiz-progress-fill {
            height: 100%;
            background: var(--gradient);
            border-radius: 4px;
            transition: width 0.5s ease;
        }

        .question-text {
            font-size: 1.2rem;
            font-weight: 600;
            line-height: 1.5;
            margin-bottom: 2rem;
        }

        .options-grid {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            margin-bottom: 1.5rem;
        }

        .option-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            color: var(--text);
            padding: 1rem 1.5rem;
            border-radius: 12px;
            text-align: left;
            cursor: pointer;
            font-size: 0.95rem;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .option-btn:hover:not(:disabled) {
            border-color: var(--primary);
            background: rgba(108, 99, 255, 0.15);
            transform: translateX(5px);
        }

        .option-btn.correct {
            border-color: var(--success) !important;
            background: rgba(67, 233, 123, 0.15) !important;
            color: var(--success) !important;
        }

        .option-btn.wrong {
            border-color: var(--danger) !important;
            background: rgba(255, 101, 132, 0.15) !important;
            color: var(--danger) !important;
        }

        .option-letter {
            width: 28px;
            height: 28px;
            background: rgba(108, 99, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .quiz-feedback {
            padding: 1rem 1.5rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
            font-size: 0.95rem;
            display: none;
        }

        .quiz-feedback.show {
            display: block;
        }

        .quiz-feedback.correct {
            background: rgba(67, 233, 123, 0.15);
            border: 1px solid var(--success);
            color: var(--success);
        }

        .quiz-feedback.wrong {
            background: rgba(255, 101, 132, 0.15);
            border: 1px solid var(--danger);
            color: var(--danger);
        }

        .quiz-actions {
            display: flex;
            justify-content: flex-end;
        }

        /* ===== RESULTS ===== */
        .results-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 3rem;
            text-align: center;
            border: 1px solid rgba(108, 99, 255, 0.2);
        }

        .score-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: conic-gradient(var(--primary) var(--score-deg, 0deg), rgba(255, 255, 255, 0.1) 0deg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            position: relative;
        }

        .score-circle::before {
            content: '';
            position: absolute;
            width: 120px;
            height: 120px;
            background: var(--card-bg);
            border-radius: 50%;
        }

        .score-text {
            position: relative;
            z-index: 1;
            font-size: 2rem;
            font-weight: 800;
        }

        .result-stats {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin: 2rem 0;
            flex-wrap: wrap;
        }

        .result-stat {
            text-align: center;
        }

        .result-stat-value {
            font-size: 1.8rem;
            font-weight: 700;
        }

        .result-stat-label {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* ===== FLASHCARDS ===== */
        .flashcard-container {
            max-width: 600px;
            margin: 0 auto;
        }

        .flashcard-wrap {
            perspective: 1000px;
            margin-bottom: 2rem;
        }

        .flashcard {
            width: 100%;
            height: 280px;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }

        .flashcard.flipped {
            transform: rotateY(180deg);
        }

        .flashcard-front,
        .flashcard-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem;
            text-align: center;
        }

        .flashcard-front {
            background: linear-gradient(135deg, var(--card-bg), rgba(108, 99, 255, 0.2));
            border: 2px solid rgba(108, 99, 255, 0.3);
        }

        .flashcard-back {
            background: linear-gradient(135deg, rgba(108, 99, 255, 0.2), var(--card-bg));
            border: 2px solid rgba(67, 233, 123, 0.3);
            transform: rotateY(180deg);
        }

        .card-label {
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 1rem;
            opacity: 0.6;
        }

        .card-content {
            font-size: 1.3rem;
            font-weight: 600;
            line-height: 1.5;
        }

        .card-hint {
            margin-top: 1rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .flashcard-controls {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .fc-btn {
            padding: 0.8rem 2rem;
            border-radius: 10px;
            border: none;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .fc-btn-know {
            background: rgba(67, 233, 123, 0.2);
            color: var(--success);
            border: 1px solid var(--success);
        }

        .fc-btn-know:hover {
            background: var(--success);
            color: white;
        }

        .fc-btn-learn {
            background: rgba(255, 101, 132, 0.2);
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        .fc-btn-learn:hover {
            background: var(--danger);
            color: white;
        }

        .fc-btn-flip {
            background: rgba(108, 99, 255, 0.2);
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .fc-btn-flip:hover {
            background: var(--primary);
            color: white;
        }

        .flashcard-counter {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .flashcard-progress {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            font-size: 0.9rem;
        }

        .fc-known {
            color: var(--success);
        }

        .fc-learning {
            color: var(--danger);
        }

        /* ===== TIMER ===== */
        .timer-app {
            max-width: 500px;
            margin: 0 auto;
        }

        .timer-display {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 3rem;
            text-align: center;
            border: 2px solid rgba(108, 99, 255, 0.2);
            margin-bottom: 1.5rem;
        }

        .timer-type-btns {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin-bottom: 2rem;
        }

        .timer-type-btn {
            padding: 0.5rem 1.2rem;
            border-radius: 20px;
            border: 1px solid rgba(108, 99, 255, 0.3);
            background: transparent;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 0.85rem;
            transition: var(--transition);
        }

        .timer-type-btn.active {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
        }

        .timer-circle {
            width: 200px;
            height: 200px;
            margin: 0 auto 2rem;
            position: relative;
        }

        .timer-svg {
            transform: rotate(-90deg);
        }

        .timer-bg-circle {
            fill: none;
            stroke: rgba(255, 255, 255, 0.1);
            stroke-width: 8;
        }

        .timer-progress-circle {
            fill: none;
            stroke: url(#timerGradient);
            stroke-width: 8;
            stroke-linecap: round;
            transition: stroke-dashoffset 1s linear;
        }

        .timer-time {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 2.5rem;
            font-weight: 800;
        }

        .timer-session {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
        }

        .timer-controls {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .timer-btn {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            font-size: 1.2rem;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .timer-btn-main {
            background: var(--gradient);
            color: white;
            width: 65px;
            height: 65px;
            box-shadow: 0 4px 20px rgba(108, 99, 255, 0.4);
        }

        .timer-btn-reset {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text);
        }

        .timer-btn:hover {
            transform: scale(1.1);
        }

        .sessions-log {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 1.5rem;
            border: 1px solid rgba(108, 99, 255, 0.2);
        }

        .sessions-log h4 {
            margin-bottom: 1rem;
            color: var(--text-muted);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .session-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
