        .toast {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            border-left: 4px solid;
            max-width: 320px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
