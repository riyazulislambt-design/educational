        function rateCard(rating) {
            const deck = FLASHCARD_DATA[state.currentDeck];
            state.cardRatings[state.currentCardIndex] = rating;

            const known = Object.values(state.cardRatings).filter(r => r === 'know').length;
            const learning = Object.values(state.cardRatings).filter(r => r === 'learning').length;
            document.getElementById('knownCount').textContent = known;
            document.getElementById('learningCount').textContent = learning;

            if (rating === 'know') showToast('Great! You know this one! ✅', 'success');
            else showToast('Added to review list 📚', 'info');

            // Go to next card
            state.currentCardIndex = (state.currentCardIndex + 1) % deck.cards.length;

            // Small animation
            const fc = document.getElementById('flashcard');
            fc.style.transform = 'scale(0.9)';
            setTimeout(() => {
                fc.style.transform = '';
                loadCard();
            }, 200);

            if (state.currentCardIndex === 0 && Object.keys(state.cardRatings).length === deck.cards.length) {
                showToast(`Deck complete! ${known}/${deck.cards.length} known 🎉`, 'success');
            }
        }

        // ===================================================
        // POMODORO TIMER
        // ===================================================
        function setTimerType(type, minutes) {
            if (state.timerRunning) { resetTimer(); }
            state.timerType = type;
            state.timerTotal = minutes * 60;
            state.timerRemaining = minutes * 60;
            updateTimerDisplay();

            document.querySelectorAll('.timer-type-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            const labels = { pomodoro: '🍅 Focus Time', short: '☕ Short Break', long: '🌿 Long Break' };
            document.getElementById('timerSession').textContent = `Session ${state.sessionCount + 1} • ${labels[type]}`;
        }

        function toggleTimer() {
            if (state.timerRunning) {
                pauseTimer();
            } else {
                startTimerRun();
            }
        }

        function startTimerRun() {
            state.timerRunning = true;
            document.getElementById('timerBtn').textContent = '⏸';

            state.timerInterval = setInterval(() => {
                state.timerRemaining--;
                updateTimerDisplay();

                if (state.timerRemaining <= 0) {
                    timerComplete();
                }
            }, 1000);
        }

        function pauseTimer() {
            state.timerRunning = false;
            clearInterval(state.timerInterval);
            document.getElementById('timerBtn').textContent = '▶';
        }

        function resetTimer() {
            pauseTimer();
            state.timerRemaining = state.timerTotal;
            updateTimerDisplay();
        }

        function skipTimer() {
            timerComplete();
        }

        function timerComplete() {
            pauseTimer();
            state.sessionCount++;

            const sessionType = state.timerType === 'pomodoro' ? '🍅 Focus' : '☕ Break';
            const duration = Math.round((state.timerTotal - state.timerRemaining) / 60);

            state.sessions.unshift({
                type: sessionType,
                duration: duration || (state.timerTotal / 60),
                time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            });

            renderSessions();
            showToast(`Session complete! Great work! 🎉`, 'success');

            // Auto-switch to break
            if (state.timerType === 'pomodoro') {
                state.timerTotal = 5 * 60;
                state.timerRemaining = 5 * 60;
                state.timerType = 'short';
                document.getElementById('timerSession').textContent = `Session ${state.sessionCount + 1} • ☕ Take a Break!`;
                document.querySelectorAll('.timer-type-btn')[1].classList.add('active');
                document.querySelectorAll('.timer-type-btn')[0].classList.remove('active');
            } else {
                state.timerTotal = 25 * 60;
                state.timerRemaining = 25 * 60;
                state.timerType = 'pomodoro';
                document.getElementById('timerSession').textContent = `Session ${state.sessionCount + 1} • 🍅 Back to Focus!`;
                document.querySelectorAll('.timer-type-btn')[0].classList.add('active');
                document.querySelectorAll('.timer-type-btn')[1].classList.remove('active');
            }

            updateTimerDisplay();
        }

        function updateTimerDisplay() {
            const minutes = Math.floor(state.timerRemaining / 60);
            const seconds = state.timerRemaining % 60;
            document.getElementById('timerDisplay').textContent =
                `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

            // Update SVG circle
            const circumference = 553;
            const progress = state.timerRemaining / state.timerTotal;
            const offset = circumference * (1 - progress);
            document.getElementById('timerCircle').style.strokeDashoffset = offset;
        }

        function renderSessions() {
            const list = document.getElementById('sessionsList');
            if (state.sessions.length === 0) {
                list.innerHTML = '<div class="empty-state"><div class="empty-state-icon">⏰</div><p>No sessions yet. Start your first session!</p></div>';
                return;
            }
            list.innerHTML = state.sessions.slice(0, 5).map(s => `
        <div class="session-item">
            <div class="session-dot"></div>
            <span>${s.type} Session</span>
            <span style="color:var(--text-muted);margin-left:auto">${s.duration}min • ${s.time}</span>
        </div>
    `).join('');
        }

        // ===================================================
        // NOTES
        // ===================================================
        function initNotes() {
            // Color picker
            const picker = document.getElementById('colorPicker');
            picker.innerHTML = NOTE_COLORS.map(color => `
        <div class="color-dot ${color === state.selectedColor ? 'selected' : ''}" 
            style="background:${color}" onclick="selectColor('${color}')"></div>
    `).join('');
        }

        function selectColor(color) {
            state.selectedColor = color;
            document.querySelectorAll('.color-dot').forEach(dot => {
                dot.classList.toggle('selected', dot.style.background === color || dot.style.backgroundColor === color);
            });
        }

        function addTag(tag) {
            if (!state.selectedTags.includes(tag)) {
                state.selectedTags.push(tag);
                renderActiveTags();
            }
        }

        function renderActiveTags() {
            const container = document.getElementById('noteTags');
            const defaultTags = ['Math', 'Science', 'English', 'Important'];
            const activeTags = state.selectedTags.map(t =>
                `<span class="tag" style="background:var(--primary);color:white" onclick="removeTag('${t}')">${t} ✕</span>`
            ).join('');
            const moreTags = defaultTags.filter(t => !state.selectedTags.includes(t)).map(t =>
                `<span class="tag" onclick="addTag('${t}')">+ ${t}</span>`
            ).join('');
            container.innerHTML = activeTags + moreTags;
        }

        function removeTag(tag) {
            state.selectedTags = state.selectedTags.filter(t => t !== tag);
            renderActiveTags();
        }

        function newNote() {
            state.editingNoteId = null;
            document.getElementById('noteTitle').value = '';
            document.getElementById('noteContent').value = '';
            state.selectedTags = [];
            state.selectedColor = NOTE_COLORS[0];
            initNotes();
            renderActiveTags();
        }

        function saveNote() {
            const title = document.getElementById('noteTitle').value.trim();
            const content = document.getElementById('noteContent').value.trim();

            if (!title && !content) {
                showToast('Please enter a title or content!', 'warning');
                return;
            }

            if (state.editingNoteId) {
                const note = state.notes.find(n => n.id === state.editingNoteId);
                if (note) {
                    note.title = title || 'Untitled Note';
                    note.content = content;
                    note.color = state.selectedColor;
                    note.tags = [...state.selectedTags];
                    note.edited = new Date().toLocaleDateString();
                }
                showToast('Note updated! ✏️', 'success');
            } else {
                state.notes.unshift({
                    id: Date.now(),
                    title: title || 'Untitled Note',
                    content: content,
                    color: state.selectedColor,
                    tags: [...state.selectedTags],
                    date: new Date().toLocaleDateString()
                });
                showToast('Note saved! 📝', 'success');
            }

            newNote();
            renderNotes();
        }

        function renderNotes(filter = '') {
            const list = document.getElementById('notesList');
            let notes = state.notes;
            if (filter) {
                notes = notes.filter(n =>
                    n.title.toLowerCase().includes(filter.toLowerCase()) ||
                    n.content.toLowerCase().includes(filter.toLowerCase()) ||
                    n.tags.some(t => t.toLowerCase().includes(filter.toLowerCase()))
                );
            }

            if (notes.length === 0) {
                list.innerHTML = `<div class="empty-state">
            <div class="empty-state-icon">📝</div>
            <p>${filter ? 'No matching notes found.' : 'No notes yet. Create your first note!'}</p>
        </div>`;
                return;
            }

            list.innerHTML = notes.map(note => `
        <div class="note-item" style="background:rgba(${hexToRgb(note.color)},0.1);border-color:${note.color};"
            onclick="editNote(${note.id})">
            <button class="note-delete" onclick="deleteNote(event, ${note.id})">🗑</button>
            <h4>${note.title}</h4>
            <p>${note.content || 'No content'}</p>
            <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:0.5rem;">
                ${note.tags.map(t => `<span style="background:rgba(108,99,255,0.2);color:var(--primary);padding:0.1rem 0.5rem;border-radius:10px;font-size:0.7rem;">${t}</span>`).join('')}
            </div>
            <div class="note-item-meta">${note.edited ? 'Edited: ' + note.edited : note.date}</div>
        </div>
    `).join('');
        }

        function editNote(id) {
            const note = state.notes.find(n => n.id === id);
            if (!note) return;
            state.editingNoteId = id;
            document.getElementById('noteTitle').value = note.title;
            document.getElementById('noteContent').value = note.content;
            state.selectedColor = note.color;
            state.selectedTags = [...note.tags];
            initNotes();
            renderActiveTags();
            showToast('Editing note...', 'info');
        }

        function deleteNote(e, id) {
            e.stopPropagation();
            state.notes = state.notes.filter(n => n.id !== id);
            if (state.editingNoteId === id) newNote();
            renderNotes();
            showToast('Note deleted!', 'info');
        }

        function searchNotes() {
            const query = document.getElementById('notesSearch').value;
            renderNotes(query);
        }

        function hexToRgb(hex) {
            const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
            return result ? `${parseInt(result[1], 16)},${parseInt(result[2], 16)},${parseInt(result[3], 16)}` : '108,99,255';
        }

